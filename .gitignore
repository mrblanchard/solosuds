# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# local verification tests (not committed)
/tests/

# personal local-only admin tool (not committed, not deployed)
/local-admin/

# stray nested clone of this repo, kept locally but not version-controlled
/solosuds/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# Google OAuth client secret JSON
client_secret*.json

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/src/generated/prisma

# generated by scripts/build-embed.mjs (see postinstall/build scripts) — not source
/public/embed.js

# Local-only deploy reference notes
*.local.md
